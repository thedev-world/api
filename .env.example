# Copy to .env and adjust for local vs Docker hosts.

DATABASE_URL=postgresql+asyncpg://devplanet:devplanet@postgres:5432/devplanet
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
GITHUB_TOKEN=your_github_token

# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=your_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_app_client_secret
OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Browser origins (comma-separated): CORS + allowlist for post-login redirect
# Include the URL users open in the browser (e.g. Next on :3000)
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# Session JWT (HS256), min 32 characters
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-32chars

SESSION_COOKIE_SECURE=false
