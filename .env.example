# Copy to .env and adjust for local vs Docker hosts.

DATABASE_URL=postgresql+asyncpg://devplanet:devplanet@postgres:5432/devplanet
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
GITHUB_TOKEN=your_github_token

# GitHub OAuth App
# Callback goes through Next.js on :3000 so OAuth cookies stay same-origin in local dev.
# Register the same URL in GitHub: Settings -> Developer settings -> OAuth Apps.
GITHUB_OAUTH_CLIENT_ID=your_oauth_app_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_oauth_app_client_secret
OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Browser origins (comma-separated): CORS + allowlist for post-login redirect
# Include the URL users open in the browser (e.g. Next on :3000)
ALLOWED_FRONTEND_ORIGINS=http://localhost:3000

# Session JWT (HS256), min 32 characters
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-32chars

# Fernet key for encrypting stored GitHub OAuth tokens
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-generate-a-fernet-key

SESSION_COOKIE_SECURE=false

# S3-compatible object storage (MinIO local, Scaleway in prod)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=devplanet
S3_SECRET_KEY=devplanet
S3_BUCKET_NAME=devplanet
S3_REGION=us-east-1
S3_PLANET_JSON_KEY=planet-data.json

FRONTEND_INTERNAL_URL=http://devplanet-front:3000
