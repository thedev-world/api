{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Devplanet API",
    "description": "Endpoints for devplanet-api (FastAPI): root, health, GitHub OAuth, authenticated GET /me and POST /me/sync, persisted user, GitHub public score.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "githubUsername",
      "value": "octocat"
    }
  ],
  "item": [
    {
      "name": "Auth (GitHub)",
      "item": [
        {
          "name": "GET /api/v1/auth/github/start",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/github/start",
            "description": "302 to GitHub; sets oauth state cookie. After authorizing, GitHub redirects to OAUTH_CALLBACK_URL (configure in API .env)."
          },
          "response": []
        },
        {
          "name": "POST /api/v1/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "description": "204; clears devplanet_session cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Root",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Service identity."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/v1/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Liveness; requires DB. Returns 503 if database check fails."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "GET /api/v1/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me",
            "description": "Current developer (session cookie). Same public shape as GET /user/{login}. 401 without valid session."
          },
          "response": []
        },
        {
          "name": "POST /api/v1/me/sync",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/me/sync",
            "description": "Requires session cookie (devplanet_session) from GitHub OAuth. Syncs the authenticated GitHub user only. Same response shape as before (sync_performed, first_sync, progress, cooldown). 401 without cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User (persisted)",
      "item": [
        {
          "name": "GET /api/v1/user/{{githubUsername}}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/user/{{githubUsername}}",
            "description": "Returns persisted aggregates + xp_brut + player_class (same name/phrase semantics as GET …/github/:user/score). Case-insensitive match in DB (unique lower index). 404 if never synced."
          },
          "response": []
        }
      ]
    },
    {
      "name": "GitHub score",
      "item": [
        {
          "name": "GET /api/v1/github/:username/score",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/github/{{githubUsername}}/score",
            "description": "Public score by GitHub username (REST + GraphQL on server). Optional: set GITHUB_TOKEN in server .env for higher rate limits—not a Postman header unless you add a gateway."
          },
          "response": []
        }
      ]
    }
  ]
}
